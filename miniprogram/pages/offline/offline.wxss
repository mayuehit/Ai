/* 单机版首页样式 */
.offline-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 20rpx;
  color: #fff;
}

/* 头部 */
.header {
  text-align: center;
  padding: 40rpx 0;
}

.logo {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 20rpx;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  opacity: 0.9;
}

/* 统计卡片 */
.stats-card {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  backdrop-filter: blur(10px);
}

.stats-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.stats-title {
  font-size: 32rpx;
  font-weight: bold;
}

.stats-clear {
  font-size: 24rpx;
  color: #ff6b6b;
  padding: 8rpx 16rpx;
  background: rgba(255, 107, 107, 0.2);
  border-radius: 10rpx;
}

.stats-content {
  display: flex;
  justify-content: space-around;
}

.stat-item {
  text-align: center;
}

.stat-value {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  opacity: 0.8;
}

/* 设置卡片 */
.settings-card {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  backdrop-filter: blur(10px);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.setting-item {
  margin-bottom: 40rpx;
}

.setting-label {
  display: block;
  font-size: 28rpx;
  margin-bottom: 20rpx;
}

.setting-hint {
  display: block;
  font-size: 24rpx;
  opacity: 0.8;
  margin-top: 10rpx;
}

.name-input {
  background: rgba(255, 255, 255, 0.2);
  border-radius: 10rpx;
  padding: 20rpx;
  color: #fff;
  font-size: 28rpx;
  margin-top: 10rpx;
}

/* 玩家卡片 */
.players-card {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  backdrop-filter: blur(10px);
}

.btn-add {
  background: rgba(76, 175, 80, 0.3);
  color: #4caf50;
  border: 1rpx solid #4caf50;
}

.players-list {
  max-height: 400rpx;
}

.player-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 15rpx;
  margin-bottom: 15rpx;
}

.player-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.player-info {
  flex: 1;
}

.player-name {
  display: block;
  font-size: 28rpx;
  margin-bottom: 5rpx;
}

.player-type {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  display: inline-block;
}

.player-type.ai {
  background: rgba(33, 150, 243, 0.3);
  color: #2196f3;
}

.player-type.human {
  background: rgba(76, 175, 80, 0.3);
  color: #4caf50;
}

.btn-remove {
  background: rgba(244, 67, 54, 0.3);
  color: #f44336;
  border: 1rpx solid #f44336;
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 10rpx;
}

.add-player-hint {
  text-align: center;
  padding: 40rpx;
  opacity: 0.7;
}

.add-player-hint text {
  display: block;
  margin-bottom: 10rpx;
}

/* 控制按钮 */
.controls {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.btn-start, .btn-new, .btn-rules {
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
}

.btn-start {
  background: linear-gradient(135deg, #4caf50, #2e7d32);
  color: white;
}

.btn-start[disabled] {
  background: rgba(255, 255, 255, 0.2);
  color: rgba(255, 255, 255, 0.5);
}

.btn-new {
  background: rgba(255, 193, 7, 0.3);
  color: #ffc107;
  border: 1rpx solid #ffc107;
}

.btn-rules {
  background: rgba(33, 150, 243, 0.3);
  color: #2196f3;
  border: 1rpx solid #2196f3;
}

/* 底部信息 */
.footer {
  text-align: center;
  padding: 20rpx;
  opacity: 0.7;
}

.footer-text {
  display: block;
  font-size: 24rpx;
  margin-bottom: 10rpx;
}

.footer-hint {
  display: block;
  font-size: 22rpx;
}

/* 模态框 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  background: white;
  border-radius: 20rpx;
  width: 80%;
  max-height: 80vh;
  overflow: hidden;
}

.modal-header {
  background: #667eea;
  color: white;
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
}

.close-btn {
  color: white;
  font-size: 40rpx;
  background: none;
  border: none;
  padding: 0;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
}

.modal-body {
  padding: 30rpx;
  color: #333;
}

.rules-content {
  font-size: 28rpx;
  line-height: 1.6;
}

.modal-footer {
  padding: 30rpx;
  text-align: center;
}

.btn-confirm {
  background: #667eea;
  color: white;
  border-radius: 40rpx;
  padding: 20rpx 60rpx;
  font-size: 28rpx;
}

/* 滑块样式 */
slider {
  margin: 20rpx 0;
}

.slider-value {
  display: block;
  text-align: center;
  font-size: 24rpx;
  opacity: 0.8;
  margin-top: 10rpx;
}