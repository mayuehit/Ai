/* 单机版游戏页面样式 */
.offline-game-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
  color: #fff;
  padding: 20rpx;
}

/* 游戏头部 */
.game-header {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  backdrop-filter: blur(10px);
}

.game-info {
  flex: 1;
}

.round-info {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.time-left {
  display: block;
  font-size: 28rpx;
  color: #ff9800;
}

.my-info {
  text-align: right;
}

.my-role {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 5rpx;
}

.my-word {
  display: block;
  font-size: 24rpx;
  opacity: 0.9;
}

/* 游戏状态指示器 */
.game-state-indicator {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  padding: 25rpx 30rpx;
  margin-bottom: 20rpx;
  text-align: center;
  backdrop-filter: blur(10px);
}

.game-state-indicator.describing {
  background: rgba(33, 150, 243, 0.2);
  border-left: 8rpx solid #2196f3;
}

.game-state-indicator.voting {
  background: rgba(244, 67, 54, 0.2);
  border-left: 8rpx solid #f44336;
}

.game-state-indicator.result {
  background: rgba(255, 193, 7, 0.2);
  border-left: 8rpx solid #ffc107;
}

.game-state-indicator.ended {
  background: rgba(76, 175, 80, 0.2);
  border-left: 8rpx solid #4caf50;
}

.state-text {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.state-hint {
  display: block;
  font-size: 24rpx;
  opacity: 0.8;
}

/* 玩家区域 */
.players-section {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  backdrop-filter: blur(10px);
}

.alive-count {
  font-size: 24rpx;
  opacity: 0.8;
}

.players-grid {
  max-height: 500rpx;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-top: 20rpx;
}

.player-card {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 15rpx;
  padding: 20rpx;
  position: relative;
  transition: all 0.3s;
}

.player-card.current {
  background: rgba(33, 150, 243, 0.2);
  border: 2rpx solid #2196f3;
}

.player-card.eliminated {
  background: rgba(244, 67, 54, 0.1);
  opacity: 0.6;
}

.player-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin: 0 auto 15rpx;
  display: block;
}

.player-badge {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  font-size: 20rpx;
  padding: 4rpx 8rpx;
  border-radius: 6rpx;
}

.player-badge.civilian {
  background: rgba(76, 175, 80, 0.3);
  color: #4caf50;
}

.player-badge.undercover {
  background: rgba(244, 67, 54, 0.3);
  color: #f44336;
}

.player-eliminated {
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  font-size: 24rpx;
  color: #f44336;
}

.player-details {
  text-align: center;
}

.player-name {
  display: block;
  font-size: 26rpx;
  font-weight: bold;
  margin-bottom: 5rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.player-type {
  font-size: 20rpx;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  display: inline-block;
  margin-bottom: 10rpx;
}

.player-type.ai {
  background: rgba(33, 150, 243, 0.3);
  color: #2196f3;
}

.player-type.human {
  background: rgba(76, 175, 80, 0.3);
  color: #4caf50;
}

.player-status {
  font-size: 20rpx;
  opacity: 0.8;
}

.turn-indicator {
  color: #2196f3;
  display: block;
}

.vote-count {
  color: #ff9800;
  display: block;
}

.my-vote {
  color: #4caf50;
  display: block;
}

/* 描述区域 */
.description-section {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  backdrop-filter: blur(10px);
}

.descriptions-list {
  max-height: 300rpx;
  margin-bottom: 30rpx;
}

.description-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 15rpx;
  margin-bottom: 15rpx;
}

.desc-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin-right: 15rpx;
  flex-shrink: 0;
}

.desc-content {
  flex: 1;
}

.desc-player {
  display: block;
  font-size: 24rpx;
  font-weight: bold;
  margin-bottom: 5rpx;
  color: #2196f3;
}

.desc-text {
  display: block;
  font-size: 26rpx;
  margin-bottom: 5rpx;
}

.desc-time {
  display: block;
  font-size: 20rpx;
  opacity: 0.6;
}

.desc-ai {
  font-size: 24rpx;
  margin-left: 10rpx;
}

/* 我的描述输入 */
.my-description {
  background: rgba(33, 150, 243, 0.1);
  border-radius: 15rpx;
  padding: 25rpx;
}

.input-area {
  position: relative;
  margin-bottom: 20rpx;
}

.desc-input {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 10rpx;
  padding: 20rpx;
  color: #fff;
  font-size: 28rpx;
  padding-right: 100rpx;
}

.char-count {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 22rpx;
  opacity: 0.6;
}

.desc-actions {
  display: flex;
  gap: 20rpx;
  margin-bottom: 15rpx;
}

.btn-skip, .btn-submit {
  flex: 1;
  height: 70rpx;
  line-height: 70rpx;
  border-radius: 35rpx;
  font-size: 28rpx;
  border: none;
}

.btn-skip {
  background: rgba(255, 193, 7, 0.3);
  color: #ffc107;
  border: 1rpx solid #ffc107;
}

.btn-submit {
  background: rgba(33, 150, 243, 0.3);
  color: #2196f3;
  border: 1rpx solid #2196f3;
}

.desc-hint {
  display: block;
  font-size: 22rpx;
  opacity: 0.7;
  text-align: center;
}

/* AI描述中 */
.ai-describing {
  background: rgba(33, 150, 243, 0.1);
  border-radius: 15rpx;
  padding: 30rpx;
  text-align: center;
}

.ai-thinking {
  margin-bottom: 20rpx;
}

.thinking-text {
  display: block;
  font-size: 28rpx;
  margin-bottom: 15rpx;
}

.thinking-dots {
  display: flex;
  justify-content: center;
  gap: 10rpx;
}

.dot {
  font-size: 40rpx;
  animation: blink 1.4s infinite;
}

.dot:nth-child(2) {
  animation-delay: 0.2s;
}

.dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes blink {
  0%, 100% { opacity: 0.2; }
  50% { opacity: 1; }
}

.ai-hint {
  display: block;
  font-size: 22rpx;
  opacity: 0.7;
}

/* 投票区域 */
.voting-section {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  backdrop-filter: blur(10px);
}

.vote-instruction {
  text-align: center;
  margin-bottom: 30rpx;
}

.vote-instruction text {
  display: block;
  margin-bottom: 10rpx;
}

.vote-hint {
  font-size: 22rpx;
  opacity: 0.7;
}

.vote-candidates {
  max-height: 400rpx;
  margin-bottom: 30rpx;
}

.candidate-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 15rpx;
  margin-bottom: 15rpx;
  transition: all 0.3s;
}

.candidate-item.selected {
  background: rgba(76, 175, 80, 0.2);
  border: 2rpx solid #4caf50;
}

.candidate-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.candidate-info {
  flex: 1;
}

.candidate-name {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 5rpx;
}

.candidate-desc {
  display: block;
  font-size: 22rpx;
  opacity: 0.8;
  margin-bottom: 5rpx;
  font-style: italic;
}

.vote-count {
  background: rgba(255, 152, 0, 0.3);
  color: #ff9800;
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  margin-right: 10rpx;
}

.vote-check {
  color: #4caf50;
  font-size: 32rpx;
  font-weight: bold;
}

.vote-actions {
  text-align: center;
}

.btn-vote {
  background: linear-gradient(135deg, #f44336, #d32f2f);
  color: white;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
  margin-bottom: 15rpx;
  width: 100%;
}

.btn-vote[disabled] {
  background: rgba(255, 255, 255, 0.2);
  color: rgba(255, 255, 255, 0.5);
}

.vote-progress {
  display: block;
  font-size: 24rpx;
  opacity: 0.8;
}

/* 结果区域 */
.result-section {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  backdrop-filter: blur(10px);
}

.result-card {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 15rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.result-card.civilian-win {
  border-left: 8rpx solid #4caf50;
}

.result-card.undercover-win {
  border-left: 8rpx solid #f44336;
}

.result-header {
  text-align: center;
  margin-bottom: 30rpx;
}

.result-title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.result-subtitle {
  display: block;
  font-size: 24rpx;
  opacity: 0.8;
}

.eliminated-player {
  display: flex;
  align-items: center;
  background: rgba(244, 67, 54, 0.1);
  border-radius: 15rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.eliminated-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.eliminated-info {
  flex: 1;
}

.eliminated-name {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 5rpx;
}

.eliminated-role, .eliminated-votes {
  display: block;
  font-size: 22rpx;
  opacity: 0.8;
}

.vote-details {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 10rpx;
  padding: 20rpx;
}

.details-title {
  display: block;
  font-size: 24rpx;
  margin-bottom: 15rpx;
  opacity: 0.8;
}

.vote-record {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
  font-size: 22rpx;
}

.voter {
  flex: 1;
  text-align: right;
  padding-right: 10rpx;
}

.vote-arrow {
  width: 40rpx;
  text-align: center;
  color: #2196f3;
}

.voted-for {
  flex: 1;
  text-align: left;
  padding-left: 10rpx;
  font-weight: bold;
}

.next-round-info {
  text-align: center;
  padding: 30rpx;
  font-size: 28rpx;
  color: #ffc107;
}

.final-actions {
  text-align: center;
}

.action-buttons {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.btn-again, .btn-home, .btn-share {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  border: none;
}

.btn-again {
  background: linear-gradient(135deg, #4caf50, #2e7d32);
  color: white;
}

.btn-home {
  background: rgba(33, 150, 243, 0.3);
  color: #2196f3;
  border: 1rpx solid #2196f3;
}

.btn-share {
  background: rgba(255, 193, 7, 0.3);
  color: #ffc107;
  border: 1rpx solid #ffc107;
}

.game-tip {
  display: block;
  font-size: 22rpx;
  opacity: 0.7;
}

/* 游戏控制 */
.game-controls {
  display: flex;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.btn-exit, .btn-save {
  flex: 1;
  height: 70rpx;
  line-height: 70rpx;
  border-radius: 35rpx;
  font-size: 28rpx;
  border: none;
}

.btn-exit {
  background: rgba(244, 67, 54, 0.3);
  color: #f44336;
  border: 1rpx solid #f44336;
}

.btn-save {
  background: rgba(33, 150, 243, 0.3);
  color: #2196f3;
  border: 1rpx solid #2196f3;
}

